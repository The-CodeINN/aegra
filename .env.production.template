# ============================================================
# Production Environment - ai-service
# Copy to .env.production and fill in real values
# NEVER commit this file with real secrets!
# ============================================================

# --- Application Settings ---
PROJECT_NAME=Aegra
VERSION="0.1.0"
DEBUG=false
AEGRA_CONFIG=aegra.json

# --- Database (internal Docker network) ---
POSTGRES_DB=aegra
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_PORT=5432
POSTGRES_USER=aegra
DB_ECHO_LOG=false

# --- Connection Pools (tuned for t3.large: 2 vCPU, 8GB RAM) ---
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_MAX_OVERFLOW=5
LANGGRAPH_MIN_POOL_SIZE=2
LANGGRAPH_MAX_POOL_SIZE=10

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# --- Authentication ---
AUTH_TYPE=noop

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
SERVER_URL=https://agent.dedatahub.io

# --- Logging ---
LOG_LEVEL=INFO
ENV_MODE=PRODUCTION
LOG_VERBOSITY=standard

# --- LLM Providers ---
OPENAI_API_KEY=sk-your-real-key-here

# --- Guardrails ---
# Enable prompt-injection screening and output leak detection (default: true)
GUARDRAILS_ENABLED=true
# Lightweight model used for injection classification
GUARDRAIL_MODEL=anthropic/claude-haiku-4-5-20250929

# --- Observability (OpenTelemetry) ---
OTEL_SERVICE_NAME=aegra-backend
OTEL_TARGETS=""
OTEL_CONSOLE_EXPORT=false

# [Target: Langfuse] (optional)
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# [Target: Arize Phoenix] (optional)
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_API_KEY=

# [Target: Generic OTLP] (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@dedatahub.com

# --- Opportunity Discovery ---
BRAVE_API_KEY=
DISCOVERY_MAX_TRACKS=2
DISCOVERY_QUERIES_PER_CATEGORY=1
DISCOVERY_PROVIDER=brave

# --- LMS service access ---
# Admin credentials used to obtain a fresh token at runtime (auto-refreshed on expiry)
ADMIN_EMAIL_ADDRESS=
ADMIN_PASSWORD=

# --- Email (SMTP) ---
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=noreply@dedatahub.com
EMAIL_FROM_NAME=DeDataHub AI Advisor

# --- MongoDB (shared with LMS backend) ---
MONGODB_URI=
