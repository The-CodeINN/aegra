# Langfuse v3 self-host + RustFS — copy to .env and fill in.
# Generate secrets with the commands shown; NEVER commit the real .env.

# --- App URL ---
# Public URL where the Langfuse UI is reached (browser). For a single host use
# http://localhost:3000; for a server put the reachable host/domain.
LANGFUSE_NEXTAUTH_URL=http://localhost:3000

# --- Core secrets ---
# NEXTAUTH_SECRET / SALT:  openssl rand -base64 32
# ENCRYPTION_KEY:          openssl rand -hex 32   (must be 64 hex chars)
NEXTAUTH_SECRET=CHANGE_ME_base64_32
SALT=CHANGE_ME_base64_32
ENCRYPTION_KEY=CHANGE_ME_hex_64
TELEMETRY_ENABLED=false

# --- Datastore passwords ---
POSTGRES_PASSWORD=CHANGE_ME
CLICKHOUSE_PASSWORD=CHANGE_ME
REDIS_AUTH=CHANGE_ME

# --- RustFS (S3) credentials ---
# Default RustFS creds are rustfsadmin/rustfsadmin — CHANGE for anything shared.
# These double as the Langfuse S3 access/secret keys.
RUSTFS_ACCESS_KEY=CHANGE_ME
RUSTFS_SECRET_KEY=CHANGE_ME
S3_BUCKET=langfuse
S3_REGION=us-east-1
# Browser-reachable RustFS S3 endpoint (host-published port 9090). For a remote
# server, set this to the public URL that resolves the RustFS S3 API.
S3_EXTERNAL_ENDPOINT=http://localhost:9090

# --- Headless project bootstrap ---
# On first boot Langfuse creates this org/project/user and these API keys, so
# you don't click through the UI. The public/secret keys below are what the
# ai-service uses as LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY.
LANGFUSE_INIT_ORG_ID=dedatahub
LANGFUSE_INIT_ORG_NAME=DeDataHub
LANGFUSE_INIT_PROJECT_ID=ai-service
LANGFUSE_INIT_PROJECT_NAME=AI Career Advisor
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGE_ME
LANGFUSE_INIT_USER_EMAIL=admin@dedatahub.io
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=CHANGE_ME
